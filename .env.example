# Copier en .env et renseigner. Le .env reel n'est jamais versionne.

# --- Broker MQTT -------------------------------------------------------------
MQTT_HOST=broker.local:1883
MQTT_USER=vcontrold
MQTT_PASS=changeme

# --- Machine cible (celle ou l'Optolink est branche) --------------------------
TARGET_HOST=user@boiler-host.local
TARGET_DIR=/home/user/vcontrold-go

# --- Port serie ---------------------------------------------------------------
# Preferer un chemin stable : ls -l /dev/serial/by-id/
SERIAL_DEVICE=/dev/serial/by-id/usb-FTDI_FT232R_USB_UART_XXXX-if00-port0

# --- Optionnel : verification cote Home Assistant ------------------------------
# Utilise seulement par les scripts de controle, pas par le daemon.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
