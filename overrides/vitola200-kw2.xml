<?xml version="1.0" encoding="utf-8"?>
<!--
  Address overrides specific to THIS machine:
  Viessmann Vitola 200 VB2A / Vitotronic 200 KW2 controller.

  vito.xml describes a family of appliances, not one specimen. This file is
  applied on top of it and never modifies it, so `make deps` can refresh the
  community XML without losing what was measured here.

  Same grammar as vito.xml. Only the fields present are overridden. Every entry
  must cite the measurement that justifies it: no guessed values.
-->
<vito>
  <commands>

    <!--
      Observed on 2026-08-08 by reading the boiler directly.

      vito.xml declares <len>2</len>. Read as 2 bytes the value is 9707; read
      as 4 bytes it is 206315 (raw EB 25 03 00). The two high bytes are 03 00,
      so the counter has already passed 65536 three times and the short read
      was showing only its low word.

      Consistency: the reading of 2025-10-07 was 196980. A gap of 9335 starts
      over ten months, about 31 a day, is plausible for this installation.
      Read as 2 bytes the gap would have been negative.
    -->
    <command name="getBrennerStarts" protocmd="getaddr">
      <addr>088A</addr>
      <len>4</len>
      <unit>CO</unit>
      <description>Ermittle die Brennerstarts</description>
    </command>


    <!--
      Return temperature. Absent from the KW profile of vito.xml, where
      getTempRueck carries an address only for device ID 2053. The 300 profile
      declares getTempRL17A at 080A, len 2, unit UT, and that address answers
      on this appliance.

      Observed on 2026-08-09: 20.0 C, while the flow (080C) read 27.7 C and the
      boiler (0802) 65.9 C. A plausible ordering for a circuit at rest in
      August, and crucially not one of the reserved values: an absent sensor
      would answer FF FF or FF 7F, as the mixers at 254C and 354C do.

      Inferred rather than confirmed: nothing here proves 080A is the return
      sensor rather than another probe that happens to answer. It is published
      as such because the 300 profile says so and the reading is consistent.

      Refuted on 2026-10-18: 080A answered 20.0 C and nothing else from
      2026-10-12 to 2026-10-18, through dozens of burner cycles and the first
      heating day, while the flow (080C) swung between 21 and 53 C. No probe is
      behind it. The address stays declared so it can still be read on demand,
      but it is no longer polled or published.
    -->
    <command name="getTempRL17A" protocmd="getaddr">
      <addr>080A</addr>
      <len>2</len>
      <unit>UT</unit>
      <description>Ermittle die Ruecklauftemperatur</description>
    </command>


    <!--
      Coding level 2 ("Codierung 2"), read on 2026-11-03.

      The service manual (Vitotronic 200 KW2, 5851 700, 11/2007) groups the
      codings by block, and each block mirrors its codings at 0x?7XX:
        00 and general codings   0x77XX
        boiler / burner 02..33   0x57XX
        DHW 55..75               0x67XX
        heating circuit A1       0x27XX (A0..FF)
        heating circuit M2       0x37XX (A0..FF)
      The general base alone (0x7702..0x7706, 0x7760) answered FF.

      Confirmed against values known on this appliance:
        37D3 = 0E, 37D4 = 00: M2 slope 1.4 and level 0, as at 0x3305 / 0x3304;
        7700 = 04: system scheme 4, "M2 with DHW", which is this installation;
        5705 = 08: boiler 8 K above the mixer circuit, factory value, and the
             boiler setpoint does run 8 K above the M2 flow setpoint;
        5706 = 55: maximum boiler water temperature 85 C, factory value;
        6760 = 14: boiler 20 K above the DHW setpoint while the tank charges,
             factory value, and the boiler setpoint reads 70 C for a 50 C tank.
      With those five in agreement, the two others are read as:
        5702 = 00: single-stage burner;
        5704 = 00: burner switching hysteresis fixed at 4 K (04:0), which the
             night of 2026-11-03 shows too: burner on at 52.4 C, off at 56.8 C,
             for a 54.5 C setpoint.

      Declared so they can be read on demand through /api/read; not polled,
      never written. The manual sets codings at the panel, and no one is known
      to have documented writing them over Optolink.
    -->
    <command name="getCod2Anlagenschema" protocmd="getaddr">
      <addr>7700</addr>
      <len>1</len>
      <unit>ST</unit>
      <description>Codierung 2, 00 Anlagenschema</description>
    </command>
    <command name="getCod2Brennertyp" protocmd="getaddr">
      <addr>5702</addr>
      <len>1</len>
      <unit>ST</unit>
      <description>Codierung 2, 02 Brennertyp (0 einstufig, 1 zweistufig, 2 modulierend)</description>
    </command>
    <command name="getCod2Schalthysterese" protocmd="getaddr">
      <addr>5704</addr>
      <len>1</len>
      <unit>ST</unit>
      <description>Codierung 2, 04 Schalthysterese Brenner (0 fest 4 K, 1 ERB50, 2 ERB80)</description>
    </command>
    <command name="getCod2Differenztemperatur" protocmd="getaddr">
      <addr>5705</addr>
      <len>1</len>
      <unit>UTI</unit>
      <description>Codierung 2, 05 Differenztemperatur Kessel ueber Mischerkreis</description>
    </command>
    <command name="getCod2KesselMax" protocmd="getaddr">
      <addr>5706</addr>
      <len>1</len>
      <unit>UTI</unit>
      <description>Codierung 2, 06 Maximalbegrenzung Kesselwassertemperatur</description>
    </command>
    <command name="getCod2UeberhoehungWW" protocmd="getaddr">
      <addr>6760</addr>
      <len>1</len>
      <unit>UTI</unit>
      <description>Codierung 2, 60 Kesselueberhoehung bei Speicherbeheizung</description>
    </command>
    <command name="getCod2NeigungM2" protocmd="getaddr">
      <addr>37D3</addr>
      <len>1</len>
      <unit>UN</unit>
      <description>Codierung 2, M2 D3 Neigung Heizkennlinie</description>
    </command>
    <command name="getCod2NiveauM2" protocmd="getaddr">
      <addr>37D4</addr>
      <len>1</len>
      <unit>ST</unit>
      <description>Codierung 2, M2 D4 Niveau Heizkennlinie</description>
    </command>

  </commands>
</vito>
